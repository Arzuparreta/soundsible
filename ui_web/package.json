{
  "name": "soundsible-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:unit": "vitest run",
    "test:ui-scale": "playwright test",
    "test:ui-scale:update": "playwright test --update-snapshots",
    "showcase": "playwright test -c showcase/playwright.config.ts",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-virtual": "^3.13.42",
    "solid-js": "^1.9.17"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
