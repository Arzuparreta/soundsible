{
  "description": "DJ route rules shared by the web client (ui_web/src/lib/djRoute.ts) and Android (ProgramDjRoutePolicy.kt). A row is {key, kind, owner?, group?, recording?}; recording defaults to key. Indices are positions in the given rows.",
  "cases": [
    {"rule": "editable_from", "name": "nothing past the playing row is protected",
     "rows": [{"key": "h", "kind": "generated"}, {"key": "cur", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "user"}],
     "current": 1, "floor": 1, "expect": 2},
    {"rule": "editable_from", "name": "a committed handoff moves the floor",
     "rows": [{"key": "h", "kind": "generated"}, {"key": "cur", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "user"}],
     "current": 1, "floor": 2, "expect": 3},
    {"rule": "editable_from", "name": "a playing bridge locks its request and that request's other bridges",
     "rows": [{"key": "p", "kind": "generated"}, {"key": "b1", "kind": "bridge", "owner": "r"}, {"key": "b2", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "g", "kind": "generated"}],
     "current": 1, "floor": 1, "expect": 4},
    {"rule": "editable_from", "name": "a committed bridge locks its request even when they are apart",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "g", "kind": "generated"}, {"key": "r", "kind": "user"}, {"key": "t", "kind": "generated"}],
     "current": 0, "floor": 1, "expect": 4},

    {"rule": "block", "name": "a request's block is its bridges and itself",
     "rows": [{"key": "s", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "o", "kind": "generated"}],
     "target": "r", "expect": ["b", "r"]},
    {"rule": "block", "name": "a bridge belongs to its request's block",
     "rows": [{"key": "s", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "o", "kind": "generated"}],
     "target": "b", "expect": ["b", "r"]},
    {"rule": "block", "name": "occurrences of one recording are told apart",
     "rows": [{"key": "first", "kind": "user", "recording": "song"}, {"key": "b", "kind": "bridge", "owner": "second"}, {"key": "second", "kind": "user", "recording": "song"}],
     "target": "b", "expect": ["b", "second"]},
    {"rule": "block", "name": "an unknown occurrence has no block",
     "rows": [{"key": "s", "kind": "generated"}], "target": "missing", "expect": null},

    {"rule": "move", "name": "a block moves past a neighbouring block whole",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "bridge", "kind": "bridge", "owner": "request"}, {"key": "request", "kind": "user"}, {"key": "other-bridge", "kind": "bridge", "owner": "other"}, {"key": "other", "kind": "user"}],
     "target": "bridge", "before": null, "floor": 0, "expect": ["seed", "other-bridge", "other", "bridge", "request"]},
    {"rule": "move", "name": "moving a request up takes its bridge with it",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "other-bridge", "kind": "bridge", "owner": "other"}, {"key": "other", "kind": "user"}, {"key": "bridge", "kind": "bridge", "owner": "request"}, {"key": "request", "kind": "user"}],
     "target": "request", "before": "other-bridge", "floor": 0, "expect": ["seed", "bridge", "request", "other-bridge", "other"]},
    {"rule": "move", "name": "a destination inside another block snaps to that block's start",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "x", "kind": "generated"}, {"key": "other-bridge", "kind": "bridge", "owner": "other"}, {"key": "other", "kind": "user"}, {"key": "y", "kind": "generated"}],
     "target": "y", "before": "other", "floor": 0, "expect": ["seed", "x", "y", "other-bridge", "other"]},
    {"rule": "move", "name": "a destination inside the moving block is refused",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}],
     "target": "r", "before": "b", "floor": 0, "expect": null},
    {"rule": "move", "name": "a block at the floor cannot move",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}],
     "target": "a", "before": null, "floor": 1, "expect": null},
    {"rule": "move", "name": "a destination at or before the floor lands right after it",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "n", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}],
     "target": "b", "before": "n", "floor": 1, "expect": ["seed", "n", "b", "a"]},
    {"rule": "move", "name": "a bridge whose request is gone cannot move",
     "rows": [{"key": "seed", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "gone"}, {"key": "a", "kind": "generated"}],
     "target": "b", "before": null, "floor": 0, "expect": null},

    {"rule": "request_insertion", "name": "a request goes right after the floor",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}],
     "floor": 0, "before": null, "expect": 1},
    {"rule": "request_insertion", "name": "a request placed before a bridged request goes before its bridge",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "a", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}],
     "floor": 0, "before": "r", "expect": 2},
    {"rule": "request_insertion", "name": "a destination at the floor falls back to right after it",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "next", "kind": "generated"}, {"key": "a", "kind": "generated"}],
     "floor": 1, "before": "next", "expect": 2},
    {"rule": "request_insertion", "name": "an unknown destination falls back to right after the floor",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "a", "kind": "generated"}],
     "floor": 0, "before": "missing", "expect": 1},

    {"rule": "remove", "name": "removing a request removes the bridges into it",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "g", "kind": "generated"}],
     "target": "r", "expect": ["b", "r"]},
    {"rule": "remove", "name": "removing a bridge keeps its request",
     "rows": [{"key": "cur", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "g", "kind": "generated"}],
     "target": "b", "expect": ["b"]},
    {"rule": "remove", "name": "an unknown occurrence removes nothing",
     "rows": [{"key": "cur", "kind": "generated"}], "target": "missing", "expect": []},

    {"rule": "repair_horizon", "name": "a short route is repaired whole",
     "future": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "user"}, {"key": "c", "kind": "generated"}],
     "limit": 16, "expect": 3},
    {"rule": "repair_horizon", "name": "a long route is cut at the limit",
     "future": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}, {"key": "c", "kind": "generated"}, {"key": "d", "kind": "generated"}, {"key": "e", "kind": "generated"}],
     "limit": 3, "expect": 3},
    {"rule": "repair_horizon", "name": "a block crossing the limit stays whole in the tail",
     "future": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}, {"key": "c", "kind": "bridge", "owner": "e"}, {"key": "d", "kind": "generated"}, {"key": "e", "kind": "user"}],
     "limit": 3, "expect": 2},
    {"rule": "repair_horizon", "name": "a block that ends at the limit is repaired",
     "future": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "c"}, {"key": "c", "kind": "user"}, {"key": "d", "kind": "generated"}],
     "limit": 3, "expect": 3},

    {"rule": "session_survivors", "name": "single requests survive with their bridges",
     "future": [{"key": "g1", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "r"}, {"key": "r", "kind": "user"}, {"key": "c1", "kind": "user", "group": "k"}, {"key": "c2", "kind": "user", "group": "k"}, {"key": "g2", "kind": "generated"}, {"key": "m", "kind": "user"}],
     "lead": null, "expect": ["b", "r", "m"]},
    {"rule": "session_survivors", "name": "a request for the new lead recording is that lead",
     "future": [{"key": "r", "kind": "user", "recording": "song"}, {"key": "b", "kind": "bridge", "owner": "r2"}, {"key": "r2", "kind": "user", "recording": "other"}],
     "lead": "song", "expect": ["b", "r2"]},

    {"rule": "replan", "name": "a request keeps its depth while the filler changes",
     "previous": [{"key": "o1", "kind": "generated"}, {"key": "q", "kind": "user", "recording": "song"}, {"key": "o2", "kind": "generated"}],
     "generated": [{"key": "n1", "kind": "generated"}, {"key": "d", "kind": "generated", "recording": "song"}, {"key": "n2", "kind": "generated"}],
     "expect": ["n1", "q", "n2"]},
    {"rule": "replan", "name": "a request's bridge stays in front of it",
     "previous": [{"key": "o1", "kind": "generated"}, {"key": "b", "kind": "bridge", "owner": "q"}, {"key": "q", "kind": "user"}, {"key": "o2", "kind": "generated"}],
     "generated": [{"key": "n1", "kind": "generated"}, {"key": "n2", "kind": "generated"}, {"key": "n3", "kind": "generated"}],
     "expect": ["n1", "b", "q", "n2", "n3"]},
    {"rule": "replan", "name": "a short replan preserves the block and Android keeps the original route",
     "previous": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}, {"key": "bridge", "kind": "bridge", "owner": "q"}, {"key": "q", "kind": "user"}],
     "generated": [{"key": "n1", "kind": "generated"}],
     "expect": ["n1", "bridge", "q"], "expect_android": null},
    {"rule": "replan", "name": "two requested occurrences of one recording both stay",
     "previous": [{"key": "f", "kind": "user", "recording": "song"}, {"key": "s", "kind": "user", "recording": "song"}],
     "generated": [{"key": "x", "kind": "generated", "recording": "song"}],
     "expect": ["f", "s"]},
    {"rule": "replan", "name": "a route without requests is replaced whole",
     "previous": [{"key": "a", "kind": "generated"}, {"key": "b", "kind": "generated"}],
     "generated": [{"key": "n1", "kind": "generated"}, {"key": "n2", "kind": "generated"}, {"key": "n3", "kind": "generated"}],
     "expect": ["n1", "n2", "n3"]}
  ]
}
