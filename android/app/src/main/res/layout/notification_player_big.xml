<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded player: full-bleed art over black, frosted control deck. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/notifArtBig"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album art"
            android:scaleType="centerCrop" />

        <!-- Frosted glass deck: dark wash, hairline top edge, controls. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC0A0A0C"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/notifTitleBig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notifArtistBig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/notifPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/notifToggle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/notifNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
