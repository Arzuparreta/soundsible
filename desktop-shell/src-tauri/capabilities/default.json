{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Soundsible consumer desktop shell capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:menu:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:default",
    "opener:default",
    "shell:default",
    "global-shortcut:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default",
    "allow-connect-server",
    "allow-change-connection",
    "allow-quit-desktop",
    "allow-get-startup-profile",
    "allow-get-shell-theme",
    "allow-start-configured-engine",
    "allow-stop-engine",
    "allow-set-autostart",
    "allow-get-autostart",
    "allow-get-engine-status",
    "allow-get-selected-folder",
    "allow-preview-music-folder",
    "allow-log-shell-event",
    "allow-start-engine",
    "allow-start-engine-with-path",
    "allow-restart-engine",
    "allow-open-logs",
    "allow-open-player",
    "allow-open-pairing",
    "allow-pairing-create-session",
    "allow-pairing-list-sessions",
    "allow-pairing-display-close",
    "allow-pairing-cancel-session",
    "allow-pairing-list-devices",
    "allow-pairing-revoke-device",
    "allow-pairing-qr-data-url"
  ]
}
