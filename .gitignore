# iOS: the Xcode project and Info.plist are generated by XcodeGen from
# ios/project.yml on the build machine. Nobody here owns a Mac to edit them
# with, so committing them would only create a file that drifts.
ios/*.xcodeproj/
ios/App/Info.plist
ios/build/
ios/**/.build/
ios/**/.swiftpm/
